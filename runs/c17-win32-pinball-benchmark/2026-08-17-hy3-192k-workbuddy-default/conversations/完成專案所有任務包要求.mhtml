playEvent*ev,int ev_count, int total_steps){
  Sim s; sim_init(&amp;s,(Scene*)sc); sim_reset(&amp;s,(Scene*)sc);
  int ei=3D0;
  for(int i=3D0;i&lt;total_steps;i++){
    int L=3D0,R=3D0,La=3D0;
    // reconstruct current pressed state from events up to step i
    int pL=3D0,pR=3D0,pLa=3D0;
    for(int k=3D0;k&lt;ev_count;k++){
      if(ev[k].step&gt;i) break;
      switch(ev[k].kind){
        case RPL_L_FLIPPER_DOWN: pL=3D1; break;
        case RPL_L_FLIPPER_UP: pL=3D0; break;
        case RPL_R_FLIPPER_DOWN: pR=3D1; break;
        case RPL_R_FLIPPER_UP: pR=3D0; break;
        case RPL_LAUNCH_DOWN: pLa=3D1; break;
        case RPL_LAUNCH_UP: pLa=3D0; break;
        default: break;
      }
    }
    sim_input(&amp;s,pL,pR,pLa,0,0,0);
    sim_step(&amp;s);
  }
  uint64_t fp=3Dsim_fingerprint(&amp;s);
  sim_free(&amp;s);
  return fp;
}
