   copy of that fixture's scene (preserving its layers/groups), then verify
   scene_write -&gt; parse_scene round-trips with the same type and count. =
*/
for(int t=3D0;t&lt;OBJ_COUNT;t++){
    int found=3D-1, found_obj=3D-1;
    for(int fi=3D0; fi&lt;nfix &amp;&amp; found&lt;0; fi++){
        char path[512]; snprintf(path,sizeof(path),&quot;%s/fixtures/%s&quo=
t;,ROOT,fixes[fi]);
        size_t len; char*text=3Dread_file(path,&amp;len); if(!text) continu=
e;
        Scene sc; scene_init(&amp;sc); DiagList d; diag_list_init(&amp;d);
        if(parse_scene(text,len,&amp;sc,&amp;d)!=3DPBT_OK){ diag_list_free(=
&amp;d); scene_free(&amp;sc); free(text); continue; }
        for(int oi=3D0; oi&lt;sc.obj_count; oi++){
            if(sc.objects[oi].type=3D=3D(ObjType)t){ found=3Dfi; found_obj=
=3Doi; break; }
        }
        diag_list_free(&amp;d); scene_free(&amp;sc); free(text);
    }
    CHECKF(found&gt;=3D0, &quot;type %d present in some fixture&quot;, t);
    if(found&lt;0){ continue; }
    /* reload that fixture and isolate the object */
    char path[512]; snprintf(path,sizeof(path),&quot;%s/fixtures/%s&quot;,R=
OOT,fixes[found]);
    size_t len; char*text=3Dread_file(path,&amp;len);
    Scene sc; scene_init(&amp;sc); DiagList d; diag_list_init(&amp;d);
    parse_scene(text,len,&amp;sc,&amp;d); free(text);
    /* remove all objects except found_obj (remove from the end) */
    int keep =3D found_obj;
    /* remove objects in descending index to keep indices stable */
    for(int oi=3Dsc.obj_count-1; oi&gt;=3D0; oi--){
        if(oi!=3Dkeep) scene_remove_object_at(&amp;sc, oi);
    }
    char*out=3Dscene_write(&amp;sc);
    int ok=3D0;
    if(out){
        Scene rt; scene_init(&amp;rt); DiagList d2; diag_list_init(&amp;d2)=
;
        PbtCode c=3Dparse_scene(out,strlen(out),&amp;rt,&amp;d2);
        if(c=3D=3DPBT_OK &amp;&amp; rt.obj_count=3D=3D1 &amp;&amp; rt.objec=
ts[0].type=3D=3D(ObjType)t) ok=3D1;
        else fprintf(stderr,&quot;DBG rtt type %d c=3D%d oc=3D%d wtype=3D%d=
\n&quot;, t,(int)c,rt.obj_count, rt.obj_count&gt;0?(int)rt.objects[0].type:=
-1);
        diag_list_free(&amp;d2); scene_free(&amp;rt); free(out);
    }
    CHECKF(ok, &quot;type %d roundtrip&quot;, t);
    diag_list_free(&amp;d); scene_free(&amp;sc);
}
