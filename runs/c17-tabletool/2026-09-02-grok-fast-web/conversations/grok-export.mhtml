DELETE ROW 4
MOVE ROW 4 TO 1
SWAP ROWS 2 3
SET CELL 4 "name" =3D "Beta2"
RENAME COLUMN "flag" TO "done"
MOVE COLUMN "name" TO 1
SWAP COLUMNS "points" "deadline"
DROP COLUMN "scratch"
WRITE "mutations_actual.md" FORMAT MARKDOWN NULL-TOKEN "NULL"
