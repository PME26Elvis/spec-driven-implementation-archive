TYPE "id" INTEGER
TYPE "points" DECIMAL
TYPE "flag" BOOLEAN
ADD COLUMN "deadline" DATE DEFAULT "2026-09-01" AT 3
ADD COLUMN "scratch" STRING DEFAULT "x"
SET CELL 2 "deadline" =3D "2026-08-31"
SET NULL 1 "deadline"
INSERT ROW AT 2 VALUES (4, "Delta", "2026-09-04", 2.50, FALSE, "i")
