{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "xml",
    "git": {
      "sortByChanges": false
    }
  },
  "include": ["**/*"],
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      "c17-win32-sudoku-task-pack-v1.0.0/**",
      "results/**",
      "include/ui/sdk_ui_font_data.h",
      "src/ui/sdk_ui_font_data.h"
    ]
  },
  "security": {
    "enableSecurityCheck": false
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
