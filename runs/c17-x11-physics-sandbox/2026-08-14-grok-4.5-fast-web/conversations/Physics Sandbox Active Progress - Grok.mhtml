if len(idxs) &gt;=3D 2:
    # remove first occurrence fully
    first =3D idxs[0]
    # find end of that function
    end =3D text.find("\n}", first) + 2
    text =3D text[:first] + text[end:]
    p.write_text(text)
    print("removed first duplicate")
else:
    print("no duplicate or only one")
