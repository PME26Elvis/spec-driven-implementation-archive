-[1.5] text-fg-secondary">        /* effective mass matrix simplified to sc=
alar for each axis */
        for (int axis =3D 0; axis &lt; 2; axis++) {
            ps_vec2 n =3D axis =3D=3D 0 ? ps_v2(1,0) : ps_v2(0,1);
            ps_scalar vn =3D ps_v2_dot(rv, n);
            ps_scalar C =3D ps_v2_dot(d, n);
            ps_scalar bias =3D 0.2f * C / dt;
            ps_scalar rna =3D ps_v2_cross(ra, n);
            ps_scalar rnb =3D ps_v2_cross(rb, n);
            ps_scalar kn =3D a-&gt;inv_mass + b-&gt;inv_mass + rna*rna*a-&g=
t;inv_inertia + rnb*rnb*b-&gt;inv_inertia;
            if (kn &lt; 1e-8f) continue;
            ps_scalar lambda =3D -(vn + bias) / kn;
            ps_vec2 P =3D ps_v2_mul(n, lambda);
            a-&gt;linear_vel =3D ps_v2_sub(a-&gt;linear_vel, ps_v2_mul(P, a=
-&gt;inv_mass));
            a-&gt;angular_vel -=3D a-&gt;inv_inertia * ps_v2_cross(ra, P);
            b-&gt;linear_vel =3D ps_v2_add(b-&gt;linear_vel, ps_v2_mul(P, b=
-&gt;inv_mass));
            b-&gt;angular_vel +=3D b-&gt;inv_inertia * ps_v2_cross(rb, P);
        }
        /* simple angle limit */
        if (j-&gt;enable_limit) {
            float ang_a =3D ps_rot2_angle(a-&gt;xf.q);
            float ang_b =3D ps_rot2_angle(b-&gt;xf.q);
            float rel =3D ang_b - ang_a;
            if (rel &lt; j-&gt;lower_angle || rel &gt; j-&gt;upper_angle) {
                float target =3D rel &lt; j-&gt;lower_angle ? j-&gt;lower_a=
ngle : j-&gt;upper_angle;
                float Cang =3D rel - target;
                float bias_a =3D 0.2f * Cang / dt;
                float kn_a =3D a-&gt;inv_inertia + b-&gt;inv_inertia;
                if (kn_a &gt; 1e-8f) {
                    float lam =3D -(a-&gt;angular_vel - b-&gt;angular_vel +=
 bias_a) / kn_a;
                    a-&gt;angular_vel -=3D a-&gt;inv_inertia * lam;
                    b-&gt;angular_vel +=3D b-&gt;inv_inertia * lam;
                }
            }
        }
    }
}

