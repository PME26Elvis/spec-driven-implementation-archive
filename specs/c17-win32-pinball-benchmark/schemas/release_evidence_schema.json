{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pinball-benchmark-release-evidence-v1",
  "title": "Pinball Benchmark Release Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "task_package_version",
    "build_id",
    "requirements"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "task_package_version": {
      "const": "1.0.0"
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 163,
      "maxItems": 163,
      "items": {
        "$ref": "#/$defs/requirementEvidence"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "requirementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "status",
        "verification_methods",
        "test_ids",
        "fixture_ids",
        "visual_ids",
        "artifacts",
        "notes"
