              "automated_test",
              "headless",
              "manual_ui",
              "visual",
              "source_audit",
              "build_audit",
              "performance",
              "fault_injection",
              "schema_validation",
              "e2e"
            ]
          },
          "uniqueItems": true
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T-[A-Z0-9]+-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "fixture_ids": {
          "type": "array",
          "items": {
