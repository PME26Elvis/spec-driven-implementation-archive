{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "xml",
    "git": {
      "sortByChanges": false
    }
  },
  "include": ["**/*"],
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      "fixtures/acceptance/*.json",
      "fixtures/acceptance/*.yaml",
      "fixtures/acceptance/traces/*.csv",
      "fixtures/acceptance/SHA256SUMS.txt",
      "fixtures/invalid/*.json",
      "fixtures/invalid/*.yaml",
      "fixtures/invalid/*.csv",
      "fixtures/invalid/SHA256SUMS.txt"
    ]
  },
  "security": {
    "enableSecurityCheck": false
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
